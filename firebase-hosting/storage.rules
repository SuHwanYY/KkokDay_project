rules_version = '2';

// 이 파일은 저장만으로는 아무 효과가 없습니다. 반드시 아래 중 하나로 배포해야
// 실제 Firebase Storage에 반영됩니다.
//   1) (권장) firebase-hosting 폴더에서: firebase deploy --only storage
//   2) Firebase Console > Storage > 규칙 탭에 이 내용을 붙여넣고 "게시"

service firebase.storage {
  match /b/{bucket}/o {

    // 장소 리뷰 사진. firestore.rules의 places/{placeDocId}/reviews/{uid} 규칙과 같은
    // 원칙 — 본인 uid 경로에만 업로드/삭제 가능, 읽기는 로그인한 사용자면 누구나 가능.
    match /reviews/{placeDocId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 마이 화면 프로필 사진. 같은 원칙 — 본인 uid 경로에만 업로드 가능, 읽기는
    // 로그인한 사용자면 누구나 가능(다른 사람 프로필 사진도 볼 일이 있을 수 있으므로).
    match /profileImages/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 그 외 모든 경로는 기본 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
