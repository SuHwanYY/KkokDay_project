rules_version = '2';

// 이 파일은 저장만으로는 아무 효과가 없습니다. 반드시 아래 중 하나로 배포해야
// 실제 Firestore에 반영됩니다.
//   1) (권장) firebase-hosting 폴더에서: firebase deploy --only firestore:rules
//   2) Firebase Console > Firestore Database > 규칙 탭에 이 내용을 붙여넣고 "게시"

service cloud.firestore {
  match /databases/{database}/documents {

    // 통합 사용자 프로필. 이메일 가입은 Firebase가 발급한 uid, 카카오 로그인은
    // "kakao:{카카오ID}" 형태의 uid를 그대로 문서 ID로 쓴다. 둘 다
    // NicknameRepositoryImpl.reserveNickname이 nicknames/{nickname} 생성과 함께
    // 트랜잭션으로 같이 만든다. 본인 uid 문서만 읽고 쓸 수 있다.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 최근 콕 찍은 곳. 하위 컬렉션엔 상위 문서의 규칙이 자동 적용되지 않으므로
    // users/{uid}와 동일한 조건을 별도로 명시한다. 본인 것만 read/write 허용.
    match /users/{uid}/recentPlaces/{placeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 즐겨찾기. recentPlaces와 동일하게 개수 제한 없이 본인 것만 read/write 허용.
    match /users/{uid}/favorites/{placeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 차단한 리뷰 작성자 목록. recentPlaces/favorites와 동일하게 본인 것만 read/write 허용 —
    // 차단은 순전히 개인 화면 설정이라 다른 사람이 볼 이유가 없다.
    match /users/{uid}/blockedAuthors/{authorUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 닉네임 중복 방지. 회원가입 전(비로그인 상태)에도 중복확인을 조회할 수 있어야 하므로
    // 읽기는 누구나 허용하고, 쓰기는 본인 uid로 예약하는 경우에만 허용한다.
    match /nicknames/{nickname} {
      allow read: if true;

      // 로그인된 사용자가, 문서에 저장하는 uid가 자기 자신의 uid와 같을 때만
      // 새 닉네임 문서를 만들 수 있다 (다른 사람이 선점한 닉네임을 만들거나 덮어쓸 수 없다).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;

      // 닉네임 변경(NicknameRepositoryImpl.changeNickname) 시 예전 닉네임 문서를 반납하기
      // 위해 본인 소유 문서만 삭제를 허용한다. update는 여전히 막는다 — uid는 절대
      // 바뀌지 않아야 하고(바뀌면 다른 사람 명의로 예약이 넘어가는 셈), 닉네임 변경은
      // "새 문서 생성 + 기존 문서 삭제"로만 이뤄진다.
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // 카카오 로그인 사용자도 users/{uid}(uid="kakao:{카카오ID}")에 통합됐다 — 위 users
    // 규칙이 그대로 적용된다. 예전에 쓰던 kakaoUsers 전용 컬렉션/규칙은 제거했다.

    // 나만의 코스. 공유 링크(웹 보기 전용 페이지)는 로그인 없이도 courseId만 알면 볼 수
    // 있어야 하므로 read는 전체 허용 — courseId(자동 생성 문서 ID)를 모르면 접근할 방법이
    // 없다는 추측 불가능성에 의존한다. 생성/수정/삭제는 본인 소유 코스만 허용.
    match /courses/{courseId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // 코스 투표. 문서 ID를 정제된 투표자 이름(voterId)으로 고정해 "이름당 투표 문서 1개"를
    // 강제한다(클라이언트는 항상 set()으로 덮어쓰기 — 같은 이름으로 다시 투표하면 자동
    // 갱신). candidateIds는 배열이라 여러 후보를 동시에 선택하는 중복 투표를 허용하고,
    // 전부 선택 해제한 빈 배열도 유효한 상태로 본다. 로그인 없이(앱 미설치 웹 방문자
    // 포함) 이름만으로 투표해야 하므로, 다른 컬렉션과 달리 request.auth를 요구하지
    // 않는다 — 그 대신 스팸 방지 장치는 없고 필드 형태만 최소한으로 검증한다(같은
    // 이름이면 남의 투표를 덮어쓸 수 있음을 감수, 배열 안 값이 실제 후보 id인지까지는
    // 안 따진다). 읽기는 courses와 동일하게 전체 허용 — 결과를 누구나 실시간으로 볼 수
    // 있어야 한다.
    match /courses/{courseId}/votes/{voterId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['voterName', 'candidateIds', 'updatedAt'])
        && request.resource.data.voterName is string
        && request.resource.data.voterName == voterId
        && request.resource.data.voterName.size() > 0
        && request.resource.data.voterName.size() <= 40
        && request.resource.data.candidateIds is list;
      allow delete: if false;
    }

    // 구글플레이 계정삭제 정책 대응 — 앱 설치 없이 delete-account.html에서 이메일만으로
    // 계정삭제를 요청할 수 있어야 하므로 votes와 마찬가지로 request.auth를 요구하지 않는다.
    // 자동 삭제는 없고 운영자가 콘솔에서 수동 확인 후 처리하므로, 클라이언트는 생성만 하고
    // 이후 read/update/delete는 전부 막는다.
    match /accountDeletionRequests/{requestId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['email', 'requestedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.email.size() <= 200;
    }

    // 장소 리뷰. 문서 ID를 uid로 고정해 "장소당 유저당 리뷰 1개"를 강제한다(클라이언트는
    // set(merge:true)로 항상 UPSERT). 본인 리뷰만 생성/수정/삭제 가능, 읽기는 로그인한
    // 사용자면 누구나 가능.
    match /places/{placeDocId}/reviews/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // 마이 탭 "내가 쓴 리뷰"는 collectionGroup("reviews")로 여러 장소의 리뷰를 한 번에
    // 조회한다. Firestore는 collectionGroup 쿼리를 고정 깊이 match(바로 위 규칙)가 아니라
    // 재귀 와일드카드 match로만 인가한다 — 이 앱에서 클라이언트가 처음 쓰는 collectionGroup
    // 쿼리라 이전까지는 이 경로가 필요 없었다. 쓰기는 항상 특정 장소 경로로 직접 이뤄지므로
    // (위 규칙이 그대로 담당) 여기선 읽기만 열어준다.
    match /{path=**}/reviews/{uid} {
      allow read: if request.auth != null;
    }

    // 리뷰 신고. 클라이언트는 생성만 할 수 있고 읽기/수정/삭제는 못 한다(구글플레이 UGC
    // 정책 대응 — 신고 내용은 운영자가 Firebase 콘솔/Admin SDK로만 확인한다). reporterUid는
    // 반드시 본인 uid여야 스팸/사칭 신고를 막을 수 있고, reason 길이도 최소한으로 검증한다.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterUid
        && request.resource.data.keys().hasOnly(['reportedReviewPath', 'reviewAuthorUid', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reportedReviewPath is string
        && request.resource.data.reviewAuthorUid is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
    }

    // 장소별 평점 집계(avgRating/reviewCount). Cloud Functions(recalculatePlaceRating,
    // 관리자 권한)만 쓴다 — 클라이언트가 평점을 직접 조작하지 못하도록 write는 전부 막는다.
    // 카테고리 목록 로드 시 이 문서만 배치 조회하면 되므로 read는 로그인한 사용자 누구나 허용.
    match /places/{placeDocId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 그 외 모든 경로는 기본 차단 (명시하지 않아도 거부되지만, 의도를 분명히 남겨둠)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
